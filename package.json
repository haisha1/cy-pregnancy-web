{
  "name": "cy-pregnancy-admin-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src tests vite.config.ts tsconfig.json package.json",
    "tokens": "node scripts/sync-app-theme.mjs",
    "tokens:check": "node scripts/sync-app-theme.mjs --check",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "vue": "3.5.44",
    "vue-router": "4.6.4",
    "pinia": "3.0.4",
    "element-plus": "2.14.7"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "vite": "7.3.7",
    "typescript": "~5.9.3",
    "vue-tsc": "3.3.13",
    "@types/node": "^24.0.0",
    "@playwright/test": "^1.56.0",
    "@axe-core/playwright": "^4.10.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
